<Window x:Class="EsrganGui.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESRGAN GUI"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="480"
        SizeToContent="Height"
        MinWidth="360"
        MaxWidth="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MessageDialogBackgroundBrush}"
        Foreground="{DynamicResource MessageDialogTextBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="16"
            Background="{DynamicResource MessageDialogSurfaceBrush}"
            BorderBrush="{DynamicResource MessageDialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="IconPanel"
                    Width="38"
                    Height="38"
                    VerticalAlignment="Top"
                    Background="{DynamicResource MessageDialogIconBackgroundBrush}"
                    CornerRadius="19">
                <TextBlock x:Name="IconGlyph"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="Bold"
                           Text="?" />
            </Border>

            <ScrollViewer x:Name="MessageScroll"
                          Grid.Column="1"
                          Margin="14,0,0,0"
                          MaxHeight="360"
                          VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False">
                <TextBlock x:Name="MessageText"
                           Foreground="{DynamicResource MessageDialogTextBrush}"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="ConfirmButton"
                        Content="确认"
                        Style="{StaticResource ButtonStyle}"
                        Click="ConfirmButton_Click" />
                <Button x:Name="YesButton"
                        Content="是"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Style="{StaticResource ButtonStyle}"
                        Click="YesButton_Click" />
                <Button x:Name="NoButton"
                        Content="否"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Style="{StaticResource ButtonStyle}"
                        Click="NoButton_Click" />
                <Button x:Name="CancelButton"
                        Content="取消"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Style="{StaticResource ButtonStyle}"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
