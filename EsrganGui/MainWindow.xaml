<Window x:Class="EsrganGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EsrganGui"
        xmlns:conv="clr-namespace:EsrganGui.Converters"
        mc:Ignorable="d"
        d:DesignWidth="1040"
        d:DesignHeight="700"
        Title="ESRGAN GUI by inori_koishi"
        Width="1040"
        Height="700"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <conv:PathToThumbnailConverter x:Key="ThumbnailConverter" DecodePixelWidth="320" />

        <!-- 卡片容器 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="1" />
        </Style>

        <!-- 蓝色进度条：Value = 已完成数量，Maximum = 总数 -->
        <Style x:Key="TaskProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 去掉 GridView 表头行默认的 2 DIP 左右留白，避免表头与卡片边框之间出现白边 -->
        <!-- 该 Margin 由 GridViewHeaderRowPresenter 在内部设置，需在代码中重置；样式 setter 优先级不够。 -->

        <!-- 列表卡片：去掉圆角与内边距，避免表头悬停时四周露出白边 -->
        <Style x:Key="ListCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- 列表列标题：完全自定义模板，不继承系统主题样式 -->
        <Style x:Key="ColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,0,1,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>

                            <!-- 列宽调整手柄，保留原有拖动调整列宽功能 -->
                            <Thumb x:Name="PART_HeaderGripper"
                                   Width="8"
                                   Margin="0,0,-4,0"
                                   HorizontalAlignment="Right"
                                   Background="Transparent"
                                   Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右侧填充用的 Padding 标题：完全透明，避免系统样式露出来 -->
        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}">
            <Style.Triggers>
                <Trigger Property="Role" Value="Padding">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 列表行 -->
        <Style x:Key="JobListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource RowBorderBrush}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                            </Trigger>
                            <!-- 完成项：Light 主题 #A3FFA3；Dark 主题适配时使用 #00DD00，文字 #000000 -->
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A3FFA3" />
                                <Setter Property="Foreground" Value="#000000" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 路径单元格文字 -->
        <Style x:Key="PathCellTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
            <Setter Property="ToolTipService.Placement" Value="Mouse" />
        </Style>

        <!-- 悬浮预览：低画质缩略图 + 完整路径 -->
        <DataTemplate x:Key="PreviewToolTipTemplate">
            <StackPanel MaxWidth="320">
                <Border Margin="6,6,6,0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="4">
                    <Grid>
                        <Image x:Name="Thumb"
                               Margin="4"
                               MaxWidth="308"
                               MaxHeight="230"
                               Stretch="Uniform"
                               Source="{Binding Converter={StaticResource ThumbnailConverter}}" />
                        <TextBlock x:Name="NoPreview"
                                   Margin="12,18"
                                   Foreground="{DynamicResource DisabledTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Text="暂无可用预览">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=Thumb}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <TextBlock Margin="8,4,8,7"
                           FontSize="11"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="{Binding}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="PreviewToolTipStyle" TargetType="ToolTip">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxWidth" Value="340" />
            <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Placement" Value="Mouse" />
        </Style>

        <!-- 序号列 -->
        <DataTemplate x:Key="IndexCellTemplate">
            <TextBlock Margin="0,0,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Binding Index}" />
        </DataTemplate>

        <!-- 原图路径列 -->
        <DataTemplate x:Key="SourcePathCellTemplate">
            <TextBlock Style="{StaticResource PathCellTextStyle}"
                       Text="{Binding SourcePath}"
                       MouseLeftButtonUp="PathCell_MouseLeftButtonUp">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding SourcePath}"
                             ContentTemplate="{StaticResource PreviewToolTipTemplate}"
                             Style="{StaticResource PreviewToolTipStyle}" />
                </TextBlock.ToolTip>
            </TextBlock>
        </DataTemplate>

        <!-- 输出图路径列 -->
        <DataTemplate x:Key="OutputPathCellTemplate">
            <TextBlock Style="{StaticResource PathCellTextStyle}"
                       Text="{Binding OutputPath}"
                       MouseLeftButtonUp="PathCell_MouseLeftButtonUp">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding OutputPath}"
                             ContentTemplate="{StaticResource PreviewToolTipTemplate}"
                             Style="{StaticResource PreviewToolTipStyle}" />
                </TextBlock.ToolTip>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上：任务列表 -->
        <Border Grid.Row="0" Style="{StaticResource ListCardStyle}">
            <Grid>
                <ListView x:Name="JobList"
                          ItemsSource="{Binding Jobs}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          SelectionMode="Extended"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemContainerStyle="{StaticResource JobListItemStyle}"
                          SizeChanged="JobList_SizeChanged"
                          PreviewMouseLeftButtonDown="JobList_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="JobList_PreviewMouseLeftButtonUp"
                          MouseMove="JobList_MouseMove"
                          LostMouseCapture="JobList_LostMouseCapture"
                          AllowDrop="True"
                          PreviewDragOver="JobList_DragOver"
                          Drop="JobList_Drop">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Width="72" CellTemplate="{StaticResource IndexCellTemplate}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Index"
                                                          Content="序号"
                                                          Style="{StaticResource ColumnHeaderStyle}"
                                                          HorizontalContentAlignment="Center" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="420" CellTemplate="{StaticResource SourcePathCellTemplate}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="SourcePath"
                                                          Content="原图路径"
                                                          Style="{StaticResource ColumnHeaderStyle}" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="420" CellTemplate="{StaticResource OutputPathCellTemplate}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="OutputPath"
                                                          Content="输出路径"
                                                          Style="{StaticResource ColumnHeaderStyle}" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 矩形框选的选框层，不参与命中测试 -->
                <Canvas x:Name="MarqueeCanvas" ClipToBounds="True" IsHitTestVisible="False">
                    <Border x:Name="MarqueeRectangle"
                            Visibility="Collapsed"
                            Background="{DynamicResource MarqueeFillBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            SnapsToDevicePixels="True" />
                </Canvas>
            </Grid>
        </Border>

        <!-- 完成进度：蓝色进度条 -->
        <ProgressBar x:Name="JobProgressBar"
                     Grid.Row="1"
                     Height="8"
                     Margin="0,12,0,0"
                     Minimum="0"
                     Maximum="1"
                     Value="0"
                     Style="{StaticResource TaskProgressBarStyle}" />

        <!-- 中：配置栏 -->
        <Border x:Name="SettingsPanel" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="模型"
                           Style="{StaticResource FieldLabelStyle}" />
                <ComboBox x:Name="ModelComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          Width="280"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding Models}"
                          SelectionChanged="ModelComboBox_SelectionChanged"
                          ToolTip="模型读取自程序目录下的 realesrgan\models" />

                <CheckBox x:Name="CompressCheckBox"
                          Grid.Row="0"
                          Grid.Column="2"
                          Content="压缩输出"
                          Margin="48,0,0,0"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          IsChecked="False"
                          Style="{StaticResource CheckBoxStyle}"
                          ToolTip="勾选后使用下方质量参数压缩输出图片"
                          Checked="OutputSettings_Changed"
                          Unchecked="OutputSettings_Changed" />

                <StackPanel Grid.Row="0"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Text="压缩质量"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="20,0,8,0" />
                    <TextBox x:Name="QualityTextBox"
                             Width="64"
                             Text="90"
                             MaxLength="3"
                             Style="{StaticResource InputBoxStyle}"
                             IsEnabled="{Binding IsChecked, ElementName=CompressCheckBox}"
                             ToolTip="1 - 100"
                             PreviewTextInput="QualityTextBox_PreviewTextInput"
                             LostFocus="QualityTextBox_LostFocus" />
                    <TextBlock Text="%"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="输出选项"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,12,8,0" />
                <ComboBox x:Name="OutputModeComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Width="280"
                          Margin="0,12,0,0"
                          Style="{StaticResource ComboBoxStyle}"
                          SelectedIndex="0"
                          SelectionChanged="OutputModeComboBox_SelectionChanged"
                          ToolTip="选择输出图片的保存位置">
                    <ComboBoxItem Content="输出到原图所在目录" />
                    <ComboBoxItem Content="输出到指定目录" />
                </ComboBox>

                <TextBlock x:Name="OutputDirectoryLabel"
                           Grid.Row="1"
                           Grid.Column="2"
                           Text="追加子目录"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="48,12,8,0" />
                <TextBox x:Name="OutputDirectoryTextBox"
                         Grid.Row="1"
                         Grid.Column="3"
                         Margin="0,12,0,0"
                         Style="{StaticResource InputBoxStyle}"
                         HorizontalAlignment="Stretch"
                         ToolTip="在原图所在目录下追加的子目录，可留空"
                         TextChanged="OutputDirectoryTextBox_TextChanged" />
            </Grid>
        </Border>

        <!-- 下：操作栏 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,11" Margin="0,12,0,0">
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button x:Name="AddImagesButton"
                            Content="添加图片..."
                            Style="{StaticResource ButtonStyle}"
                            Click="AddImagesButton_Click" />
                    <Button x:Name="RemoveSelectedButton"
                            Content="删除所选项"
                            Margin="10,0,0,0"
                            Style="{StaticResource ButtonStyle}"
                            Click="RemoveSelectedButton_Click" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding Jobs.Count, StringFormat='共 {0} 项'}" />
                    <TextBlock x:Name="StatusText"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="就绪" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="StartButton"
                            Content="开始执行"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="StartButton_Click" />
                    <Button x:Name="StopButton"
                            Content="强制停止"
                            Margin="10,0,0,0"
                            IsEnabled="False"
                            Style="{StaticResource ButtonStyle}"
                            Click="StopButton_Click" />
                    <Button x:Name="PreferencesButton"
                            Content="首选项..."
                            Margin="10,0,0,0"
                            Style="{StaticResource ButtonStyle}"
                            Click="PreferencesButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
