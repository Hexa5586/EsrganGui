<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark 主题：配色参考 Dracula，主题色沿用 Light 的蓝色 #2563EB -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#282A36" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#21222C" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2C2E3E" />

    <SolidColorBrush x:Key="TextBrush" Color="#F8F8F2" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A9B1C9" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6272A4" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#44475A" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#6272A4" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="MessageDialogBackgroundBrush" Color="#282A36" />
    <SolidColorBrush x:Key="MessageDialogSurfaceBrush" Color="#21222C" />
    <SolidColorBrush x:Key="MessageDialogTextBrush" Color="#F8F8F2" />
    <SolidColorBrush x:Key="MessageDialogBorderBrush" Color="#44475A" />
    <SolidColorBrush x:Key="MessageDialogIconBackgroundBrush" Color="#2C2E3E" />
    <SolidColorBrush x:Key="MessageDialogWarningBrush" Color="#FFB86C" />
    <SolidColorBrush x:Key="MessageDialogErrorBrush" Color="#FF5555" />

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2C2E3E" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2C2E3E" />
    <SolidColorBrush x:Key="InputDisabledBackgroundBrush" Color="#262835" />
    <SolidColorBrush x:Key="CheckBoxBackgroundBrush" Color="#2C2E3E" />

    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#2C2E3E" />
    <SolidColorBrush x:Key="HeaderHoverBrush" Color="#343748" />
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#D7DBEA" />
    <SolidColorBrush x:Key="RowBorderBrush" Color="#343746" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#2C2E3E" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#44475A" />
    <SolidColorBrush x:Key="FailedRowBackgroundBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="FailedRowForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="DropDownBackgroundBrush" Color="#21222C" />
    <SolidColorBrush x:Key="DropDownHoverBrush" Color="#343748" />
    <SolidColorBrush x:Key="DropDownSelectedBrush" Color="#44475A" />

    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#21222C" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#44475A" />

    <SolidColorBrush x:Key="MarqueeFillBrush" Color="#552563EB" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#44475A" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#6272A4" />

</ResourceDictionary>
