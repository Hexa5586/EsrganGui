<Window x:Class="EsrganGui.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560"
        d:DesignHeight="500"
        Title="首选项"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="560"
        Height="500"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- 分组卡片 -->
        <Style x:Key="PreferenceGroupStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,0,12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{TemplateBinding Header}" />
                                <ContentPresenter Grid.Row="1" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 可滚动的主容器 -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="外观" Style="{StaticResource PreferenceGroupStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="ThemeComboBox"
                                      Grid.Column="1"
                                      Width="200"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource ComboBoxStyle}">
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                                <ComboBoxItem Content="跟随系统" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="输出" Style="{StaticResource PreferenceGroupStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="后缀" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="SuffixTextBox"
                                     Grid.Column="1"
                                     MaxLength="128"
                                     Style="{StaticResource InputBoxStyle}"
                                     ToolTip="可用模板：%MODEL%、%SCALE%、%COMPRESS%" />
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="%MODEL%：模型名；%SCALE%：放大倍数；%COMPRESS%：压缩质量"
                                       Style="{StaticResource HintTextStyle}" />
                            <CheckBox x:Name="RemoveTrailingUnderscoreCheckBox"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Content="去除文件名末尾的下划线"
                                      Margin="0,12,0,0"
                                      Style="{StaticResource CheckBoxStyle}" />
                            <CheckBox x:Name="DeleteUncompressedCheckBox"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      Content="删除未压缩的输出图片（启用压缩时生效）"
                                      Margin="0,8,0,0"
                                      Style="{StaticResource CheckBoxStyle}" />
                        </Grid>
                        
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="日志" Style="{StaticResource PreferenceGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="清空日志"
                                    Style="{StaticResource ButtonStyle}"
                                    Click="ClearLogButton_Click" />
                            <Button Content="打开日志"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource ButtonStyle}"
                                    Click="OpenLogButton_Click" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="应用"
                    Style="{StaticResource ButtonStyle}"
                    Click="ApplyButton_Click" />
            <Button Content="确定"
                    Margin="10,0,0,0"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="取消"
                    Margin="10,0,0,0"
                    Style="{StaticResource ButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
