<Window x:Class="EsrganGui.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560"
        d:DesignHeight="500"
        Title="首选项"
        Width="560"
        Height="500"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- 分组卡片 -->
        <Style x:Key="PreferenceGroupStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,0,12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{TemplateBinding Header}" />
                                <ContentPresenter Grid.Row="1" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 可滚动的主容器 -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="外观" Style="{StaticResource PreferenceGroupStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="ThemeComboBox"
                                      Grid.Column="1"
                                      Width="200"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource ComboBoxStyle}">
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                                <ComboBoxItem Content="跟随系统" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="选择“跟随系统”时，会根据 Windows 的应用主题自动切换浅色或深色。"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="输出" Style="{StaticResource PreferenceGroupStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="文件后缀选项" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="SuffixModeComboBox"
                                      Grid.Column="1"
                                      Width="200"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="SuffixModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="使用模型名" />
                                <ComboBoxItem Content="使用放大倍数" />
                                <ComboBoxItem Content="使用给定后缀" />
                            </ComboBox>

                            <TextBlock x:Name="SuffixLabel"
                                       Grid.Row="1"
                                       Text="后缀"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,12,8,0" />
                            <TextBox x:Name="SuffixTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,12,0,0"
                                     MaxLength="64"
                                     Style="{StaticResource InputBoxStyle}" />
                        </Grid>
                        <TextBlock Text="选择“使用给定后缀”时，可自定义输出文件名的后缀。"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="应用"
                    Style="{StaticResource ButtonStyle}"
                    Click="ApplyButton_Click" />
            <Button Content="确定"
                    Margin="10,0,0,0"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="取消"
                    Margin="10,0,0,0"
                    Style="{StaticResource ButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
